# memrank CLI -- leaderboard/eval tooling configuration.
#
# Copy to `memrank/.env`. The CLI reads THIS file and only this file, anchored to the
# package directory -- NOT the directory you invoke it from. There is no repo-root .env
# anymore: that filename (and its DATABASE_URL) is exactly what dbmate auto-loads, so the
# CLI squatting on it handed dbmate the leaderboard publisher's DSN as a migration DSN.
# Other services own their config the same way: memrank/api/.env (accounts API),
# supabase/functions/arena/.env (Arena Edge), db/.env (dbmate). A process can point
# memrank.config at a different file with MEMRANK_ENV_FILE (an override, not a search
# path -- see memrank/config.py).
#
# API KEYS DO NOT BELONG HERE. `config.secret()` deliberately does not read this file: a
# key in a file silently satisfies a requirement that is genuinely unmet in CI and in the
# cloud, which is how a broken credential preflight survived weeks of local runs.
# Credentials live in memrank's own wallet:
#
#   memrank secrets set ANTHROPIC_API_KEY      # one key
#   memrank secrets import-env                 # migrate an existing env file
#   memrank secrets list                       # what a run would actually find
#
# Exported environment variables are still read -- ECS resolves SSM into the container
# environment and CI injects secrets the same way. Only the implicit file is gone.
# Everything below is NON-SECRET configuration.
#
# NOTE ON DSNs: do NOT append `?pgbouncer=true`. That is a Prisma/Supabase-pooler
# convention, not a libpq parameter -- psycopg3 rejects the whole DSN with
# `invalid URI query parameter: "pgbouncer"`, and the pool then fails 30s later at first
# use rather than at startup. Transaction-pooler compatibility is already handled in code
# by `prepare_threshold=None` in every store.

# -- Publisher / leaderboard-publish + leaderboard-gc ------------------------------------
# Least-privilege pooled DSN for the memrank_lb_publisher role (SELECT run_results only).
DATABASE_URL=postgresql://memrank_lb_publisher:<LB_PUBLISHER_PASSWORD>@<host>:6543/<dbname>

# -- Ingest / leaderboard-ingest ---------------------------------------------------------
# Least-privilege DSN for the memrank_lb_ingest role (SELECT+INSERT on both tables).
# NEVER the same credential as DATABASE_URL in production.
INGEST_DATABASE_URL=postgresql://memrank_lb_ingest:<LB_INGEST_PASSWORD>@<host>:6543/<dbname>

# -- S3 artifact storage (leaderboard-ingest + leaderboard-gc) ---------------------------
# Private S3 bucket holding raw run artifacts, provisioned by infra/environments/prod.
# No AWS keys here: region and credentials resolve through the standard AWS chain
# (AWS_PROFILE / env / instance role). Locally, direnv exports AWS_PROFILE=atomic for
# this workspace; verify with `aws sts get-caller-identity` before running ingest.
LEADERBOARD_ARTIFACT_BUCKET=memrank-run-artifacts-<account-id>

# -- Accounts (memrank auth login / auth status / run --org) ---------------------------------------
# Where the CLI reaches the memrank accounts API. Required by the login-dependent commands
# rather than defaulted to localhost: a CLI that guessed localhost could send a credential
# to whatever happened to be listening there. The local dev API listens on :8100.
MEMRANK_API_URL=http://127.0.0.1:8100

# Overrides the stored CLI token (CI, Docker, SSH -- anywhere with no OS keyring).
# MEMRANK_TOKEN=mrk_...
